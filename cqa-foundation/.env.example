# Copy this file to .env and fill in. Never commit .env.

# Organiser data API (from the CQA Student Guide)
CQA_API_URL=
CQA_GROUP_ID=

# LLM: provider = openai (any OpenAI-compatible API, incl. Ollama) | anthropic | mock
# Leave LLM_API_KEY empty to run the offline demo judge.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Prices per 1M tokens in USD, for the cost-per-evaluation report
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0

# Local models (Ollama) are slower: wait longer, send fewer requests at once
LLM_TIMEOUT=120
LLM_MAX_WORKERS=8

# Language of the AI explanations shown in the UI (verdicts are not affected)
EXPLANATION_LANGUAGE=Russian
