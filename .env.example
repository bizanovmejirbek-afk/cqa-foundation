# Скопируйте этот файл в .env и заполните. Файл .env НЕ загружайте в Git.

# API организаторов (из CQA Student Guide)
CQA_API_URL=
CQA_GROUP_ID=

# Модель: anthropic | openai (любой OpenAI-совместимый API, в т.ч. Ollama) | mock
# Без LLM_API_KEY работает офлайн mock-судья (только для демонстрации интерфейса).
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Цена за 1M токенов в USD (для расчёта стоимости одной оценки)
LLM_PRICE_IN_PER_1M=0.10
LLM_PRICE_OUT_PER_1M=0.50

# Время ожидания ответа и число параллельных запросов
LLM_TIMEOUT=120
LLM_MAX_WORKERS=8

# Язык объяснений AI в интерфейсе (на вердикты не влияет)
EXPLANATION_LANGUAGE=Russian

# Название команды для results/dev и results/prod
TEAM_NAME=Data Pulse
